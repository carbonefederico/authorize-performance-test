# Profile: stage-1000 — extended reference level 1000 decisions/second.
# Outside the original campaign bound (500/s): the first three levels showed
# the sideband path at ~1% CPU with falling latency, so this level probes
# where the embedded PDP actually starts working. Same run shape as the
# campaign levels (10 agents, 5m measured + 30s warmup) so the results stay
# comparable; thresholds unchanged.
#
# Usage: PROFILE=stage-1000 ./scripts/run-in-cluster.sh

# --- Distribution -----------------------------------------------------
AGENTS=10

# --- Load shape (TOTAL across all agents) -----------------------------
RATE=1000
DURATION=5m
WARMUP=30s
PRE_ALLOCATED_VUS=50
MAX_VUS=120
P95_MS=500
SUCCESS_RATE=0.99
INSECURE_SKIP_TLS_VERIFY=true

# --- Subject tokens (self-signed by k6, validated by PAZ's trusted cert) ---
SUBJECT_ISSUER=https://paz-perf-subject
SUBJECT_USER_COUNT=100

# MCP_AUD and PAZ_SIDEBAND_URL come from .env (profiles never override them:
# they must match the policy snapshot's constants and the deployed Service).
