# Profile: stage-2000 — extended level 2000 decisions/second.
# The 1000/s level stayed at ~2% CPU with clean p95, so this probes the next
# doubling. Same run shape (10 agents, 5m measured + 30s warmup, weighted mix,
# unchanged thresholds); concurrency scaled to the 200/s-per-agent arrival
# rate. 2000/10 = 200/agent exactly — no drift.
#
# Usage: PROFILE=stage-2000 ./scripts/run-in-cluster.sh

# --- Distribution -----------------------------------------------------
AGENTS=10

# --- Load shape (TOTAL across all agents) -----------------------------
RATE=2000
DURATION=5m
WARMUP=30s
PRE_ALLOCATED_VUS=100
MAX_VUS=240
P95_MS=500
SUCCESS_RATE=0.99
INSECURE_SKIP_TLS_VERIFY=true

# --- Subject tokens (self-signed by k6, validated by PAZ's JWKS fetch) ---
SUBJECT_ISSUER=https://paz-perf-subject
SUBJECT_USER_COUNT=100

# MCP_AUD and PAZ_SIDEBAND_URL come from .env (profiles never override them:
# they must match the policy snapshot's constants and the deployed Service).
