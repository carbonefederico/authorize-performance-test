# Profile: agents — 10 distributed k6 agents at the .env default rate (50/s).
# Post-deploy sanity profile: proves the distributed path end to end before
# a campaign ladder. Same workload model as the stage profiles; only RATE
# differs (it inherits RATE from .env).
#
# Usage: PROFILE=agents ./scripts/run-in-cluster.sh

# --- Distribution -----------------------------------------------------
AGENTS=10

# --- Load shape (TOTAL across all agents) -----------------------------
DURATION=5m
WARMUP=30s
PRE_ALLOCATED_VUS=25
MAX_VUS=60
P95_MS=500
SUCCESS_RATE=0.99
INSECURE_SKIP_TLS_VERIFY=true

# --- Subject tokens (self-signed by k6, validated by PAZ's trusted cert) ---
SUBJECT_ISSUER=https://paz-perf-subject
SUBJECT_USER_COUNT=100
