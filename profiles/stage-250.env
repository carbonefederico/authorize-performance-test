# Profile: stage-250 — reference level 250 decisions/second.
# One of the campaign's three fixed reference levels (100/250/500). The
# campaign bound is 500/s: never run a level above it, and never run a level
# to failure (shared cluster; see the README's scope section).
#
# Usage: ./scripts/run-in-cluster.sh with PROFILE=stage-250 in .env, or
# PROFILE=stage-250 ./scripts/run-in-cluster.sh

# --- Distribution -----------------------------------------------------
AGENTS=10

# --- Load shape (TOTAL across all agents) -----------------------------
RATE=250
DURATION=5m
WARMUP=30s
PRE_ALLOCATED_VUS=25
MAX_VUS=60
P95_MS=500
SUCCESS_RATE=0.99
INSECURE_SKIP_TLS_VERIFY=true

# --- Subject tokens (self-signed by k6, validated by PAZ's trusted cert) ---
SUBJECT_ISSUER=https://paz-perf-subject
SUBJECT_USER_COUNT=100

# MCP_AUD and PAZ_SIDEBAND_URL come from .env (profiles never override them:
# they must match the policy snapshot's constants and the deployed Service).
