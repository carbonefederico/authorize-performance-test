# PAZ sideband performance test — lab configuration.
# Copy to .env and fill in. .env is git-ignored and never committed.

# Kubernetes and Helm
NAMESPACE=paz-perf
PAZ_RELEASE=paz
LOADTEST_RELEASE=loadtest
PING_CHART_VERSION=0.15.0

# The Ping products clone their server profile from this repository at boot
# (server-profiles/ is part of this project). Point this at the GitHub
# remote — for the HTTPS clone URL no credentials are needed if the repo is
# public.
SERVER_PROFILE_URL=https://github.com/carbonefederico/authorize-performance-test.git
SERVER_PROFILE_BRANCH=main

# Ping DevOps evaluation licensing (eval account credentials; do not commit).
# create-secrets.sh folds these into the cluster Secret 'devops-secret' —
# the only place they exist outside this local .env.
PING_IDENTITY_DEVOPS_USER=
PING_IDENTITY_DEVOPS_KEY=
PING_IDENTITY_ACCEPT_EULA=YES

# PAP admin console password — the lab constant the Ping images boot with
# (the DevOps default). Our scripts (build-package, scrape-monitor) use it
# to authenticate against PAP/PAZ admin interfaces; nothing injects it into
# the products.
PAP_ADMIN_PASSWORD=2FederateM0re

# SIDEBAND_SHARED_SECRET is the one generated value: leave it empty here and
# create-secrets.sh generates it once and writes it back to this .env, so k6
# and PAZ share a single value across redeploys.
SIDEBAND_SHARED_SECRET=

# Subject-token signing key (private, generated by generate-signing-key.sh).
# PAZ validates tokens against the matching self-signed certificate, which
# ships in the PAZ server profile — no JWKS server exists in this stack.
SUBJECT_SIGNING_KEY_FILE=${ROOT_DIR}/keys/subject-signing.key

# Subject-token claims (rotating synthetic VIP users; see README).
SUBJECT_ISSUER=https://paz-perf-subject
SUBJECT_USER_COUNT=100
MCP_AUD=https://agentgateway-stack-ag.ping-devops.com/mcp/portfolio

# Where the load generator reaches PAZ's Sideband API (in-cluster Service).
PAZ_SIDEBAND_URL=https://paz-pingauthorize:8443/sideband/request

# k6 load shape and pass/fail thresholds.
RATE=50
DURATION=5m
WARMUP=30s
AGENTS=10
PRE_ALLOCATED_VUS=25
MAX_VUS=200
P95_MS=500
SUCCESS_RATE=0.99
REQUEST_TIMEOUT=30s
INSECURE_SKIP_TLS_VERIFY=true

# Local port for reaching PAP (build-package.sh) and PAZ (smoke.sh) through
# kubectl port-forward.
PAP_PORT_FORWARD=18443
