# 20-token-validator.dsconfig.subst — issuer-publishes/verifier-fetches model.
# Subject tokens are self-signed RS256 by the load generator (kid
# perf-subject-key). PAZ validates them against the in-cluster JWKS server
# (helm/paz/templates/jwks-server.yaml): the issuer publishes the key set at
# http://<release>-jwks/.well-known/jwks.json, PAZ fetches and caches it —
# the production distribution model, with key rotation pickup behavior on
# the path. The JWKS document itself is generated from the same signing key
# by scripts/generate-jwks.sh, so token shapes are unchanged from the
# trusted-certificate era; only distribution changed.
#
# The JWKS service name is release-derived: the chart deploys <release>-jwks
# in the same namespace, and PAZ env PAZ_RELEASE_NAME (values.yaml) carries
# the release name into this substitution.

dsconfig create-external-server \
    --server-name perf-jwks \
    --type http \
    --set "base-url:http://${PAZ_RELEASE_NAME}-jwks" \
    --set hostname-verification-method:strict

dsconfig create-access-token-validator \
    --validator-name PerfSubjectJWT \
    --type jwt \
    --set enabled:true \
    --set allowed-signing-algorithm:RS256 \
    --set authorization-server:perf-jwks \
    --set jwks-endpoint-path:/.well-known/jwks.json
